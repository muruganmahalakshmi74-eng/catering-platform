# Server
NODE_ENV=development
PORT=5000

# Database (required - the server refuses to start without it)
MONGO_URI=mongodb://localhost:27017/catering_platform

# Auth (required) - use a long random string in any real deployment
JWT_SECRET=change_me_to_a_long_random_string

# Optional: restrict browser origins. Defaults to * for local development.
# CORS_ORIGIN=http://localhost:5173
